<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily" Width="390" Height="540" MinWidth="340" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Foreground="#293831" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3F7059"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#526159"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3F7059"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CircleStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid Background="Transparent">
          <Ellipse x:Name="Circle" Width="21" Height="21" Stroke="#99A69E" StrokeThickness="1.5" Fill="Transparent"/>
          <Path x:Name="Check" Data="M 0,5 L 4,9 L 11,1" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          <Ellipse x:Name="FocusRing" Width="30" Height="30" Stroke="#3F7059" StrokeDashArray="2 2" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#3F7059"/><Setter TargetName="Circle" Property="Stroke" Value="#3F7059"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="#3F7059"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PinStyle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Surface" CornerRadius="9" Background="Transparent">
          <Path x:Name="Pin" Width="16" Height="18" Stretch="Uniform" Data="M 5,1 L 13,1 M 6,1 L 6,7 L 3,10 L 3,12 L 15,12 L 15,10 L 12,7 L 12,1 M 9,12 L 9,18" Stroke="#62746A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E0EBE2"/><Setter TargetName="Pin" Property="Stroke" Value="#355F48"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3F7059"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Margin="12" Background="#FCFBF8" CornerRadius="20" BorderBrush="#DDE1D9" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#26382C"/></Border.Effect>
    <Grid Margin="22,12,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="Transparent" Margin="-8,0,-8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CloseButton" Width="24" Height="28" Padding="0" ToolTip="关闭" AutomationProperties.Name="关闭窗口"><Ellipse Width="12" Height="12" Fill="#EF8277" Stroke="#DC7268" StrokeThickness="0.7"/></Button>
          <Button x:Name="MinimizeButton" Width="24" Height="28" Padding="0" ToolTip="最小化" AutomationProperties.Name="最小化窗口"><Ellipse Width="12" Height="12" Fill="#EAC16B" Stroke="#D9AD55" StrokeThickness="0.7"/></Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="DAILY" FontSize="10" FontWeight="SemiBold" Foreground="#6F7A71" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <ToggleButton x:Name="PinButton" Grid.Column="2" Style="{StaticResource PinStyle}" AutomationProperties.Name="窗口置顶"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,18,0,20">
        <TextBlock x:Name="DateLabel" FontSize="12" Foreground="#67756C" Margin="0,0,0,7"/>
        <TextBlock Text="Daily" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="把今天，过得有条不紊。" Foreground="#657269" FontSize="12" Margin="1,8,0,0"/>
      </StackPanel>
      <Border Grid.Row="2" Background="#F0F2EC" CornerRadius="12" BorderBrush="#E2E6DD" BorderThickness="1" Padding="12,6,6,6" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TaskInput" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="0,4" MaxLength="200" FontSize="13" Foreground="#293831" AutomationProperties.Name="新的待办事项"/>
          <TextBlock x:Name="InputHint" Text="添加一件想做的事…" Foreground="#6B776D" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Button x:Name="AddButton" Grid.Column="1" Width="32" Height="32" Padding="0" Background="#3F7059" Foreground="White" ToolTip="添加 · Enter" AutomationProperties.Name="添加待办"><TextBlock Text="+" FontSize="22" Margin="0,-2,0,0"/></Button>
        </Grid>
      </Border>
      <Grid Grid.Row="3">
        <ScrollViewer x:Name="TaskScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
          <StackPanel x:Name="TaskRows"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
          <Border Width="52" Height="52" CornerRadius="18" Background="#EBF0E7" Margin="0,0,0,14"><TextBlock Text="☀" Foreground="#55745B" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="给今天一个小小的开始" FontSize="14" HorizontalAlignment="Center"/>
          <TextBlock Text="从一件简单的事开始就好" Foreground="#69766D" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <Border Height="1" Background="#E6E9E1" Margin="0,0,0,13"/>
        <Grid>
          <TextBlock x:Name="ProgressLabel" Foreground="#5E6C62" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="SaveLabel" Text="本机自动保存" Foreground="#69766D" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="3" BorderThickness="0" Background="#E6EAE1" Foreground="#65876A" Margin="0,10,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

